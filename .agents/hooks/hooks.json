{
  "session-start": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash .agents/hooks/antigravity/session-start.sh",
        "timeout": 10
      }
    ]
  },
  "session-end": {
    "Stop": [
      {
        "type": "command",
        "command": "bash .agents/hooks/antigravity/session-end.sh",
        "timeout": 10
      }
    ]
  },
  "branch-and-qa-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/antigravity/branch-guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "workspace-path-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/antigravity/workspace-path-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/antigravity/post-tool-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "sdd-cache": {
    "PreToolUse": [
      {
        "matcher": "read_url_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/antigravity/sdd-cache-pre.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "read_url_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/antigravity/sdd-cache-post.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
