# ==============================================================================
# AGENT SKILLS CONFIGURATION TEMPLATE (.env.example)
# Single Source of Truth cho toàn bộ dự án (SDLC 7 personas, tests & ChatOps).
# Copy file này thành .env tại thư mục gốc và điền các giá trị thực tế của bạn:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE WORKSPACE & AGENT CLI CONFIGURATION
# ------------------------------------------------------------------------------
# Đường dẫn CLI Agent thực thi (mặc định ưu tiên agy, fallback sang claude)
AGENT_CLI_PATH=/path/to/agy_or_claude

# Đường dẫn workspace gốc của agent-skills (repo này)
AGENT_WORKSPACE_DIR=/path/to/agent-skills

# Thư mục chứa các project/group cần Agent tự động phát hiện và scan (phân tách bằng dấu phẩy)
PROJECT_SCAN_DIRS=/path/to/repo1,/path/to/repo2

# ------------------------------------------------------------------------------
# 1b. AI MODEL CONFIGURATION (Google Gemini & Antigravity)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_AGENT_MODEL=antigravity
GEMINI_FLASH_MODEL=gemini-2.5-flash
TYPESAFE_API_KEY=your_typesafe_api_key_here

# ------------------------------------------------------------------------------
# 1c. N8N FAST-PATH CONFIGURATION
# Dự án vận hành theo chuẩn n8n-only. Khởi động bằng npm run n8n:up
# ------------------------------------------------------------------------------
N8N_ENABLED=true
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
N8N_BASE_URL=http://localhost:5678
# Timeout webhook (ms). Tăng lên 15000 nếu kết nối chậm
N8N_WEBHOOK_TIMEOUT_MS=8000
# Chỉ bật true trong môi trường nội bộ dùng self-signed TLS cert
ALLOW_INSECURE_TLS=false
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh
# Secret để verify webhook đẩy từ GitLab/GitHub (tùy chọn)
GITLAB_WEBHOOK_SECRET=your_gitlab_webhook_secret_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ------------------------------------------------------------------------------
# 2. JIRA / ATLASSIAN & FIGMA CONFIGURATION
# ------------------------------------------------------------------------------
ATLASSIAN_BASE_URL=https://example.atlassian.net
ATLASSIAN_EMAIL=user@example.com
ATLASSIAN_API_TOKEN=your_atlassian_api_token_here
# Aliases hỗ trợ script Jira trực tiếp (tự động fallback từ ATLASSIAN_*)
JIRA_BASE_URL=https://example.atlassian.net
JIRA_EMAIL=user@example.com
JIRA_API_TOKEN=your_atlassian_api_token_here
# Account ID của bạn trên Jira Cloud (lấy từ profile Jira)
JIRA_MY_ACCOUNT_ID=your_jira_account_id_here
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
JIRA_BOARD_ID=your_board_id_here
JIRA_TEAM_NAME=your_team_name_here
JIRA_SPRINT_CUSTOM_FIELD=customfield_10018
JIRA_STORY_POINTS_FIELD=customfield_10028
STANDUP_STUCK_DAYS_THRESHOLD=2

# Figma API (dùng cho trích xuất UI specs & design tokens)
FIGMA_API_BASE_URL=https://api.figma.com/v1
FIGMA_API_TOKEN=your_figma_personal_access_token_here

# ------------------------------------------------------------------------------
# 3. SQUASH TM CONFIGURATION
# ------------------------------------------------------------------------------
SQUASH_BASE_URL=https://squash.example.com
SQUASH_USERNAME=your_squash_username
SQUASH_PASSWORD=your_squash_password
SQUASH_API_TOKEN=your_squash_api_token_here
SQUASH_PROJECT_ID=your_squash_project_id
SQUASH_REQ_G31_FOLDER_ID=your_requirement_folder_id
SQUASH_TC_G31_FOLDER_ID=your_testcase_folder_id

# ------------------------------------------------------------------------------
# 4. SLACK INTEGRATION (CHATOPS & DAILY STANDUP)
# ------------------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_REPORT_CHANNEL_ID=your_slack_channel_id_here
SLACK_REPORT_CHANNEL_NAME=#team-standup
SLACK_API_BASE_URL=https://slack.com/api

# ------------------------------------------------------------------------------
# 5. GITLAB CONFIGURATION
# ------------------------------------------------------------------------------
GITLAB_API_URL=https://gitlab.example.com/api/v4
GITLAB_PERSONAL_ACCESS_TOKEN=your_gitlab_personal_access_token_here
GITLAB_PERMISSION_MODE=readonly
GITLAB_DENIED_TOOLS_REGEX=^(create_|update_|delete_|push_|merge_|approve_|unapprove_|resolve_|retry_|cancel_|mark_).*

# ------------------------------------------------------------------------------
# 6. METABASE DATABASE CONFIGURATION (UAT & PROD READ-ONLY)
# ------------------------------------------------------------------------------
METABASE_ENV=uat
METABASE_DEFAULT_DATABASE=

# --- Metabase UAT ---
METABASE_UAT_URL=https://mb-uat.example.com
METABASE_UAT_API_TOKEN=your_metabase_uat_api_token_here
METABASE_UAT_SESSION_TOKEN=your_metabase_uat_session_token_here
METABASE_UAT_DB_TIMESCALE_ID=your_uat_timescale_db_id
METABASE_UAT_DB_OPENAPI_ID=your_uat_openapi_db_id
METABASE_UAT_DB_OPENAPI_SANDBOX_ID=your_uat_sandbox_db_id

# --- Metabase Production (Read-only SSO) ---
METABASE_PROD_URL=https://mb.example.com
METABASE_PROD_API_TOKEN=your_metabase_prod_api_token_here
METABASE_PROD_SESSION_TOKEN=your_metabase_prod_session_token_here
METABASE_PROD_DB_TIMESCALE_ID=your_prod_db_id
METABASE_PROD_DB_OPENAPI_ID=your_prod_db_id

# --- Metabase Fallback / Direct Active ---
METABASE_URL=https://mb-uat.example.com
METABASE_API_TOKEN=your_metabase_api_token_here
METABASE_SESSION_TOKEN=your_metabase_session_token_here
METABASE_DB_ID=your_db_id
METABASE_DB_SANDBOX_ID=your_sandbox_db_id
METABASE_DB_TIMESCALE_ID=your_uat_timescale_db_id
METABASE_DB_OPENAPI_ID=your_uat_openapi_db_id
METABASE_DB_OPENAPI_SANDBOX_ID=your_uat_sandbox_db_id

# --- Metabase Settings & Recon ---
DB_STATEMENT_TIMEOUT=30000
RECON_STATEMENT_TIMEOUT=30000
RECON_CONCURRENCY=5

# ------------------------------------------------------------------------------
# 7. TRADING / OPENAPI TEST CREDENTIALS
# ------------------------------------------------------------------------------
BASE_URL=https://openapi-uat.example.com
API_KEY=your_openapi_api_key_here
API_SECRET=your_openapi_api_secret_here
DNSE_API_VERSION=v3
ACCOUNT_NO=your_account_no_here
OPENAPI_TYK_PATH=/openapi-tyk

# --- User Tier Accounts (Data Isolation & Rate Limit Tests) ---
NORMAL_USER_API_KEY=your_normal_user_api_key_here
NORMAL_USER_API_SECRET=your_normal_user_api_secret_here
VIP_USER_API_TOKEN=your_vip_user_api_token_here
VIP_USER_API_SECRET=your_vip_user_api_secret_here
ULTIMATE_USER_API_TOKEN=your_ultimate_user_api_token_here
ULTIMATE_USER_API_SECRET=your_ultimate_user_api_secret_here

# --- WebSocket Streaming ---
WS_URL=wss://ws-openapi-uat.example.com
WS_MARKET_URL=wss://market-stream-uat.example.com
WS_ADMIN_URL=wss://ws-admin-uat.example.com
WS_ENCODING=json
WS_AUTO_RECONNECT=true

# --- Connector / Stream Thresholds ---
NORMAL_USER_MAX_CONNECTOR=10
NORMAL_USER_MAX_STREAM=200
VIP_USER_MAX_CONNECTOR=25
VIP_USER_MAX_STREAM=400
ULTIMATE_USER_MAX_CONNECTOR=50
ULTIMATE_USER_MAX_STREAM=400

# ------------------------------------------------------------------------------
# 8. WEB DASHBOARD & PLAYWRIGHT TEST RUNNER
# ------------------------------------------------------------------------------
DASHBOARD_URL=https://dashboard-uat.example.com/
DASHBOARD_USERNAME=your_dashboard_username
DASHBOARD_PASSWORD=your_dashboard_password

WEB_BASE_URL=https://web-uat.example.com/
ISSUE_KEY_URL=https://{issueKey}.trading-test.example.com/
TRADING_USERNAME=your_trading_username
TRADING_PASSWORD=your_trading_password
TRADING_INVESTOR_ID=your_trading_investor_id_here
WEB_API_TOKEN=your_web_api_token_here
# UAT Web Auth (dùng cho capture-asis-dom và UI discovery)
UAT_USERNAME=your_uat_username
UAT_PASSWORD=your_uat_password

# --- Local Repo Paths for Design Mockup & Discovery ---
WEB_TRADING_ROOT=/path/to/web-trading-repo
MOBILE_TRADING_ROOT=/path/to/mobile-trading-repo
CHROME_BIN=/path/to/google-chrome

# --- Playwright Browser Automation Config ---
BROWSER=chromium
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
HEADLESS=false
SLOW_MO_MS=0
PLAYWRIGHT_TIMEOUT_MS=30000
NAV_TIMEOUT_MS=15000
PLAYWRIGHT_TRACE=retain-on-failure

# ------------------------------------------------------------------------------
# 9. SIMULATOR ADMIN (ORS & MARKET OPERATOR)
# ------------------------------------------------------------------------------
ORS_ADMIN_URL=https://api-uat.example.com
ORS_FO_URL=https://api-fo-uat.example.com
ORS_ADMIN_USERNAME=admin@example.com
ORS_ADMIN_PASSWORD=your_ors_admin_password_here

MO_ADMIN_URL=https://mo-admin-uat.example.com
MO_ADMIN_USERNAME=admin@example.com
MO_ADMIN_PASSWORD=your_mo_admin_password_here

# ------------------------------------------------------------------------------
# 10. MOBILE APP TESTING (APPIUM)
# ------------------------------------------------------------------------------
APPIUM_SERVER_URL=http://127.0.0.1:4723
APP_PACKAGE=com.example.trading
APP_ACTIVITY=.MainActivity
