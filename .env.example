# ==============================================================================
# AGENT SKILLS CONFIGURATION TEMPLATE (.env.example)
# Single Source of Truth cho toàn bộ dự án (SDLC 7 personas, tests & ChatOps).
# Copy file này thành .env tại thư mục gốc và điền các giá trị thực tế của bạn:
#   cp .env.example .env
# ==============================================================================

# Đường dẫn CLI Agent thực thi (mặc định ưu tiên agy, fallback sang claude)
AGENT_CLI_PATH=/path/to/agy_or_claude

# Đường dẫn workspace gốc của agent-skills (repo này)
AGENT_WORKSPACE_DIR=/Users/your-name/Desktop/Project/Test/agent-skills

# Thư mục chứa các project/group cần Agent tự động phát hiện và scan (phân tách bằng dấu phẩy)
# Ví dụ: chẹa nhiều repo GitLab, hay folder group có nhiều sub-repo:
PROJECT_SCAN_DIRS=/path/to/3.1,/path/to/3.2,/path/to/agent-skills

# ------------------------------------------------------------------------------
# 1b. GEMINI AI CONFIGURATION (Google AI Studio)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
# Dùng trong n8n workflow: Mattermost Router (Intent Recognition), Standup Summary...
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# 2 model được dùng trong dự án:
# - antigravity : Intent Classifier ChatOps (Agents, 80 RPM, 100 RPD)
# - gemini-3.8-flash: Mọi tác vụ còn lại (Summary, Jira cleanup, Repo report) (5 RPM, 20 RPD)
GEMINI_AGENT_MODEL=antigravity
GEMINI_FLASH_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 1c. N8N CONFIGURATION
# Cấu hình n8n Fast-Path. Dự án vận hành theo chuẩn n8n-only.
# ------------------------------------------------------------------------------
N8N_ENABLED=true
N8N_BASE_URL=http://localhost:5678
N8N_PORT=5678
# Timeout webhook (ms). Tăng lên 15000 nếu kết nối chậm
N8N_WEBHOOK_TIMEOUT_MS=8000
# Static domain ngrok (không gồm https://). Nếu điền, `npm run n8n:bg` tự chạy thêm tiến trình ngrok-tunnel.
# Ví dụ: dinosaur-cute.ngrok-free.app — để trống nếu không dùng ChatOps/Mattermost.
NGROK_DOMAIN=
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh
# Secret để verify GitLab/GitHub push webhook (tùy chọn, thêm vào GitLab Webhook settings)
GITLAB_WEBHOOK_SECRET=your_gitlab_webhook_secret_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ------------------------------------------------------------------------------
# 2. JIRA / ATLASSIAN CONFIGURATION
# ------------------------------------------------------------------------------
ATLASSIAN_BASE_URL=https://example.atlassian.net
ATLASSIAN_EMAIL=user@example.com
ATLASSIAN_API_TOKEN=your_atlassian_api_token_here
FIGMA_API_TOKEN=your_figma_personal_access_token_here

# ------------------------------------------------------------------------------
# 3. SQUASH TM CONFIGURATION
# ------------------------------------------------------------------------------
SQUASH_BASE_URL=https://squash.example.com
SQUASH_USERNAME=your_squash_username
SQUASH_PASSWORD=your_squash_password
SQUASH_API_TOKEN=your_squash_api_token_here
SQUASH_PROJECT_ID=your_squash_project_id
SQUASH_REQ_G31_FOLDER_ID=your_requirement_folder_id
SQUASH_TC_G31_FOLDER_ID=your_testcase_folder_id

# ------------------------------------------------------------------------------
# 4. MATTERMOST NOTIFICATIONS
# ------------------------------------------------------------------------------
MATTERMOST_WEBHOOK_URL=https://mattermost.example.com/hooks/your_webhook_token_here

# ------------------------------------------------------------------------------
# 5. GITLAB CONFIGURATION
# ------------------------------------------------------------------------------
GITLAB_API_URL=https://gitlab.example.com
GITLAB_PERSONAL_ACCESS_TOKEN=your_gitlab_personal_access_token_here
GITLAB_PERMISSION_MODE=readonly
GITLAB_DENIED_TOOLS_REGEX=.*(delete|remove|drop|truncate).*

# ------------------------------------------------------------------------------
# 6. METABASE DATABASE CONFIGURATION (UAT & PROD)
# ------------------------------------------------------------------------------
METABASE_ENV=uat
METABASE_DEFAULT_DATABASE=timescale

# --- Metabase UAT ---
METABASE_UAT_URL=https://mb-uat.example.com
METABASE_UAT_API_TOKEN=your_metabase_uat_api_token_here
METABASE_UAT_DB_TIMESCALE_ID=644
METABASE_UAT_DB_OPENAPI_ID=535
METABASE_UAT_DB_OPENAPI_SANDBOX_ID=655

# --- Metabase Production (Read-only SSO) ---
METABASE_PROD_URL=https://mb.example.com
METABASE_PROD_SESSION_TOKEN=your_metabase_prod_session_token_here
METABASE_PROD_DB_TIMESCALE_ID=7
METABASE_PROD_DB_OPENAPI_ID=266

# --- Metabase Fallback / Direct Active ---
METABASE_URL=https://mb-uat.example.com
METABASE_API_TOKEN=your_metabase_api_token_here
METABASE_SESSION_TOKEN=your_metabase_session_token_here
METABASE_DB_TIMESCALE_ID=644
METABASE_DB_OPENAPI_ID=535
METABASE_DB_OPENAPI_SANDBOX_ID=655

# ------------------------------------------------------------------------------
# 7. TRADING / OPENAPI TEST CREDENTIALS
# ------------------------------------------------------------------------------
BASE_URL=https://openapi-uat.example.com
API_KEY=your_openapi_api_key_here
API_SECRET=your_openapi_api_secret_here

NORMAL_USER_API_KEY=your_normal_user_api_key_here
NORMAL_USER_API_SECRET=your_normal_user_api_secret_here
VIP_USER_API_TOKEN=your_vip_user_api_token_here
VIP_USER_API_SECRET=your_vip_user_api_secret_here
ULTIMATE_USER_API_TOKEN=your_ultimate_user_api_token_here
ULTIMATE_USER_API_SECRET=your_ultimate_user_api_secret_here

# --- WebSocket Streaming ---
WS_URL=wss://ws-openapi-uat.example.com
WS_ADMIN_URL=wss://ws-admin-uat.example.com
WS_ENCODING=json
WS_AUTO_RECONNECT=true

# --- Connector / Stream Thresholds ---
NORMAL_USER_MAX_CONNECTOR=2
NORMAL_USER_MAX_STREAM=5
VIP_USER_MAX_CONNECTOR=5
VIP_USER_MAX_STREAM=10
ULTIMATE_USER_MAX_CONNECTOR=10
ULTIMATE_USER_MAX_STREAM=20

# ------------------------------------------------------------------------------
# 8. WEB DASHBOARD & TRADING SIMULATOR
# ------------------------------------------------------------------------------
DASHBOARD_URL=https://dashboard-uat.example.com
DASHBOARD_USERNAME=your_dashboard_username
DASHBOARD_PASSWORD=your_dashboard_password

WEB_BASE_URL=https://web-uat.example.com
TRADING_USERNAME=your_trading_username
TRADING_PASSWORD=your_trading_password
TRADING_INVESTOR_ID=your_trading_investor_id_here
WEB_API_TOKEN=your_web_api_token_here

# ------------------------------------------------------------------------------
# 9. ORS ADMIN (EXECUTION REPORT SIMULATOR)
# ------------------------------------------------------------------------------
ORS_ADMIN_URL=https://api-uat.example.com
ORS_FO_URL=https://api-fo-uat.example.com
ORS_ADMIN_USERNAME=admin@example.com
ORS_ADMIN_PASSWORD=your_ors_admin_password_here

# ------------------------------------------------------------------------------
# 10. MOBILE APP TESTING (APPIUM)
# ------------------------------------------------------------------------------
APPIUM_SERVER_URL=http://127.0.0.1:4723
APP_PACKAGE=com.example.trading
APP_ACTIVITY=.MainActivity
