{
  "name": "agent-skills",
  "version": "1.0.0",
  "private": true,
  "description": "Bộ sưu tập kỹ năng cấp sản xuất cho AI coding agents — BA, DEV, QA, Scrum Master, Code Reviewer, Security Auditor, Web Performance Auditor.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup:mac": "bash scripts/setup-mac.sh",
    "build": "node scripts/build-commands.js",
    "pretest": "npm run build",
    "lint": "npm run validate",
    "test": "npm run validate && npm run test:unit && npm run evals",
    "validate": "npm run validate:skills && npm run validate:commands && npm run validate:versions && npm run validate:links && npm run validate:paths",
    "validate:skills": "node scripts/validate-skills.js",
    "validate:commands": "node scripts/validate-commands.js",
    "validate:versions": "node scripts/validate-versions.js",
    "validate:links": "node scripts/validate-reference-links.js",
    "validate:paths": "node scripts/validate-artifact-paths.js",
    "test:unit": "node --test scripts/*-test.js",
    "evals": "node scripts/run-evals.js",
    "setup:plugins": "node scripts/setup-plugins.js",
    "unlink:plugins": "node scripts/setup-plugins.js --unlink",
    "metabase:login": "node scripts/metabase-sso-login.js",
    "db:recon": "node scripts/db-recon.js",
    "db:recon:prod": "node scripts/db-recon-prod.js",
    "repo:sync": "node scripts/repo-sync.js",
    "sync": "node scripts/repo-sync.js",
    "n8n": "n8n start",
    "n8n:tunnel": "n8n start --tunnel",
    "n8n:setup": "node scripts/setup-n8n.js",
    "n8n:bg": "pm2 start ecosystem.config.cjs",
    "n8n:stop": "pm2 stop n8n-agent-skills",
    "n8n:restart": "pm2 restart n8n-agent-skills",
    "n8n:status": "pm2 status n8n-agent-skills",
    "n8n:logs": "pm2 logs n8n-agent-skills",
    "n8n:import": "n8n import:workflow --separate --input=n8n-workflows/",
    "n8n:export": "n8n export:workflow --all --separate --output=n8n-workflows/",
    "n8n:clean": "node scripts/n8n-clean-workflows.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "md-to-adf": "^0.6.4",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "pm2": "^7.0.4"
  }
}
