{
  "name": "agent-skills",
  "version": "1.0.0",
  "private": true,
  "description": "Bộ sưu tập kỹ năng cấp sản xuất cho AI coding agents — BA, DEV, QA, Scrum Master, Code Reviewer, Security Auditor, Web Performance Auditor.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup:mac": "bash scripts/setup/setup-mac.sh",
    "build": "node scripts/setup/build-commands.js",
    "pretest": "npm run build",
    "lint": "npm run validate",
    "test": "npm run validate && npm run test:unit && npm run evals",
    "validate": "npm run validate:skills && npm run validate:commands && npm run validate:versions && npm run validate:links && npm run validate:paths && npm run validate:icons && npm run validate:nodes && npm run validate:tokens",
    "validate:skills": "node scripts/validators/validate-skills.js",
    "validate:commands": "node scripts/validators/validate-commands.js",
    "validate:versions": "node scripts/validators/validate-versions.js",
    "validate:links": "node scripts/validators/validate-reference-links.js",
    "validate:paths": "node scripts/validators/validate-artifact-paths.js",
    "validate:icons": "node plugins/ba-po/skills/ba-design-flowchart/assets/build_icons_gallery.mjs --check",
    "validate:nodes": "node scripts/n8n/sync-n8n-nodes.js --check",
    "validate:tokens": "node scripts/validators/validate-skill-tokens.js",
    "test:unit": "node --test scripts/tests/*-test.js",
    "workspace:archive": "node scripts/workspace/archive-issues.js",
    "checkpoint:diff": "node scripts/checkpoint/diff-checkpoint.js",
    "evals": "node scripts/evals/run-evals.js --min-rank1 90",
    "setup:plugins": "node scripts/setup/setup-plugins.js",
    "unlink:plugins": "node scripts/setup/setup-plugins.js --unlink",
    "plugin:export": "node scripts/setup/export-plugin.js",
    "setup:claude": "node scripts/setup/setup-claude.js",
    "setup:hooks": "mkdir -p .git/hooks && cp .agents/hooks/core/check-branch.sh .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "unlink:claude": "node scripts/setup/setup-claude.js --unlink",
    "metabase:login": "node scripts/db/metabase-sso-login.js",
    "db:recon": "node scripts/db/db-recon.js",
    "db:recon:prod": "METABASE_ENV=prod node scripts/db/db-recon.js",
    "db:recon:core": "node scripts/db/db-recon-core.js",
    "sync": "node scripts/sync/repo-sync.js",
    "scan:ui-components": "node plugins/ba-po/skills/ba-refine/assets/generate-ui-component-map.js",
    "n8n": "n8n start",
    "n8n:setup": "node scripts/setup/setup-n8n.js",
    "n8n:bg": "pm2 start config/ecosystem.config.cjs",
    "n8n:autostart": "node scripts/setup/n8n-autostart.js",
    "n8n:stop": "pm2 stop config/ecosystem.config.cjs",
    "n8n:restart": "pm2 restart config/ecosystem.config.cjs",
    "n8n:status": "pm2 status",
    "n8n:logs": "pm2 logs",
    "n8n:import": "for d in n8n-workflows/*/; do n8n import:workflow --separate --input=$d; done",
    "n8n:export": "n8n export:workflow --all --separate --output=n8n-workflows/ops/",
    "n8n:clean": "node scripts/n8n/n8n-clean-workflows.js",
    "n8n:sync-nodes": "node scripts/n8n/sync-n8n-nodes.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "md-to-adf": "^0.6.4",
    "playwright": "^1.62.1",
    "pm2": "^7.0.4",
    "smol-toml": "^1.8.0"
  }
}
