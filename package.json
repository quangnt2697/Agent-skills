{
  "name": "agent-skills",
  "version": "1.0.0",
  "private": true,
  "description": "Bộ sưu tập kỹ năng cấp sản xuất cho AI coding agents — BA, DEV, QA, Scrum Master, Code Reviewer, Security Auditor, Web Performance Auditor.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup:mac": "bash scripts/setup/setup-mac.sh",
    "build": "node scripts/setup/build-commands.js",
    "pretest": "npm run build",
    "lint": "npm run validate",
    "test": "npm run validate && npm run test:unit && npm run evals",
    "validate": "npm run validate:skills && npm run validate:commands && npm run validate:versions && npm run validate:links && npm run validate:paths && npm run validate:icons",
    "validate:skills": "node scripts/validators/validate-skills.js",
    "validate:commands": "node scripts/validators/validate-commands.js",
    "validate:versions": "node scripts/validators/validate-versions.js",
    "validate:links": "node scripts/validators/validate-reference-links.js",
    "validate:paths": "node scripts/validators/validate-artifact-paths.js",
    "validate:icons": "node plugins/ba-po/skills/ba-design-flowchart/scripts/build_icons_gallery.mjs --check",
    "test:unit": "node --test scripts/tests/*-test.js",
    "evals": "node scripts/evals/run-evals.js",
    "setup": "node scripts/setup/setup-plugins.js",
    "setup:plugins": "node scripts/setup/setup-plugins.js",
    "setup:plugins:symlink": "node scripts/setup/setup-plugins.js --symlink",
    "unlink:plugins": "node scripts/setup/setup-plugins.js --unlink",
    "metabase:login": "node scripts/db/metabase-sso-login.js",
    "db:recon": "node scripts/db/db-recon.js",
    "db:recon:prod": "node scripts/db/db-recon-prod.js",
    "db:recon:core": "node scripts/db/db-recon-core.js",
    "repo:sync": "node scripts/sync/repo-sync.js",
    "sync": "npm run repo:sync",
    "n8n": "n8n start",
    "n8n:tunnel": "n8n start --tunnel",
    "n8n:setup": "node scripts/setup/setup-n8n.js",
    "n8n:bg": "pm2 start ecosystem.config.cjs",
    "n8n:autostart": "node scripts/setup/n8n-autostart.js on",
    "n8n:autostart:off": "node scripts/setup/n8n-autostart.js off",
    "n8n:stop": "pm2 stop ecosystem.config.cjs",
    "n8n:restart": "pm2 restart ecosystem.config.cjs",
    "n8n:status": "pm2 status",
    "n8n:logs": "pm2 logs",
    "n8n:import": "n8n import:workflow --separate --input=n8n-workflows/",
    "n8n:export": "n8n export:workflow --all --separate --output=n8n-workflows/",
    "n8n:clean": "node scripts/n8n/n8n-clean-workflows.js",
    "n8n:sync-nodes": "node scripts/n8n/sync-n8n-nodes.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "md-to-adf": "^0.6.4",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "pm2": "^7.0.4",
    "smol-toml": "^1.8.0"
  }
}
