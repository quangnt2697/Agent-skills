# =================================================================
# ENV TEMPLATE — Web UI / Mobile Tasks (Playwright)
# Sao chép file này thành workspace/{issueKey}/test/.env
# =================================================================
# ⚠️  NGUYÊN TẮC BẮT BUỘC:
#   1. KHÔNG hardcode credentials vào test script — chỉ đọc qua os.getenv().
#   2. KHÔNG dùng mock server / fake HTTP adapter — test trực tiếp trên hệ thống thật.
#   3. KHÔNG hardcode URL — chỉ trỏ WEB_BASE_URL hoặc ISSUE_KEY_URL từ file này.
#   4. Dữ liệu thị trường (giá, mã CK) BẮT BUỘC lấy từ Metabase UAT, không tự bịa.
#
# 💡 KHÔNG CẦN ĐIỀN LẠI CREDENTIALS Ở ĐÂY:
#   Toàn bộ credentials (TRADING_USERNAME, TRADING_PASSWORD, DASHBOARD_USERNAME,
#   DASHBOARD_PASSWORD, METABASE_UAT_API_TOKEN...) đã được tập trung tại:
#   → agent-skills/.env  (kho trung tâm toàn máy, được bảo vệ bởi .gitignore)
#   conftest.py tự động nạp từ đó qua load_hierarchical_env(). File này chỉ
#   khai báo các biến đặc thù của task (URL per-branch, Playwright config).
# =================================================================

# ── Môi Trường ──────────────────────────────────────────────────
ENVIRONMENT=uat

# ── Trading Platform Web URLs ────────────────────────────────────
# URL ổn định cho môi trường dev/test (dùng mặc định cho mọi task)
# Kế thừa từ agent-skills/.env → WEB_BASE_URL (không cần ghi đè nếu dùng default)
WEB_BASE_URL=https://dev.trading-test.dnse.com.vn/

# URL per-feature-branch: thay {issueKey} bằng issueKey thực tế của task
# VD: STK-201 → https://stk-201.trading-test.dnse.com.vn/
# Kế thừa từ agent-skills/.env → ISSUE_KEY_URL (không cần ghi đè nếu dùng default)
ISSUE_KEY_URL=https://{issueKey}.trading-test.dnse.com.vn/

# ── Dashboard / Backoffice ───────────────────────────────────────
DASHBOARD_URL=https://dashboard-uat.dnse.com.vn

# ── Credentials — KHÔNG ĐIỀN Ở ĐÂY ─────────────────────────────
# Các biến dưới đây được tự động kế thừa từ agent-skills/.env:
#   TRADING_USERNAME, TRADING_PASSWORD, TRADING_INVESTOR_ID
#   DASHBOARD_USERNAME, DASHBOARD_PASSWORD
#   WEB_API_TOKEN (auto-populate sau khi đăng nhập)
# Chỉ khai báo lại tại đây nếu task này dùng tài khoản KHÁC với central .env.
# TRADING_USERNAME=<leave empty — inherited from agent-skills/.env>
# TRADING_PASSWORD=<leave empty — inherited from agent-skills/.env>
# DASHBOARD_USERNAME=<leave empty — inherited from agent-skills/.env>
# DASHBOARD_PASSWORD=<leave empty — inherited from agent-skills/.env>

# ── Playwright Browser ───────────────────────────────────────────
# chromium | firefox | webkit
BROWSER=chromium
# Desktop viewport (1920x1080 là chuẩn bắt buộc theo automation_rules)
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
# Mobile emulation (dùng trong test responsive/mobile)
MOBILE_DEVICE=Pixel 7
# Headless mode: true = chạy ẩn | false = hiện cửa sổ trình duyệt
# BẮT BUỘC false khi viết mới script để dùng Playwright MCP lấy locator chính xác
HEADLESS=false
# Slow-motion (ms giữa các bước — tăng khi debug hoặc ghi video)
SLOW_MO_MS=0

# ── Timeout ─────────────────────────────────────────────────────
# Timeout tối đa cho mỗi page action (ms)
PLAYWRIGHT_TIMEOUT_MS=30000
# Timeout cho navigation (ms)
NAV_TIMEOUT_MS=15000

# ── Screenshot & Trace ───────────────────────────────────────────
# Thư mục lưu ảnh chụp khi test fail
SCREENSHOT_DIR=workspace/{issueKey}/test/result/screenshots
# Bật Playwright trace (on | off | retain-on-failure)
PLAYWRIGHT_TRACE=retain-on-failure

# ── Output ──────────────────────────────────────────────────────
RESULT_DIR=workspace/{issueKey}/test/result

