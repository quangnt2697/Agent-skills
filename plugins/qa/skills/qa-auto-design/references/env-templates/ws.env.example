# =================================================================
# ENV TEMPLATE — WebSocket Tasks
# Sao chép file này thành workspace/{issueKey}/test/.env
# =================================================================

# ── Môi Trường ──────────────────────────────────────────────────
ENVIRONMENT=uat

# ── REST API Base URL (dùng để đặt lệnh trong test E2E) ─────────
BASE_URL=https://openapi-uat.dnse.com.vn

# ── WebSocket URLs ───────────────────────────────────────────────
# Trading WebSocket (Kênh lệnh, tài khoản)
WS_URL=wss://ws-openapi-uat.dnse.com.vn/trading
# Market Data WebSocket (Bảng giá, tick feed)
WS_MARKET_URL=wss://ws-openapi-uat.dnse.com.vn/marketdata

# ── Xác Thực ────────────────────────────────────────────────────
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# User B (dùng cho test Data Isolation)
NORMAL_USER_API_KEY=user_b_api_key_here
NORMAL_USER_API_SECRET=user_b_api_secret_here

# ── Tài Khoản Kiểm Thử ──────────────────────────────────────────
UAT_ACCOUNT_NO=your_account_no_here

# ── Tham Số Kết Nối WebSocket ───────────────────────────────────
# Encoding: msgpack (mặc định) | json
WS_ENCODING=msgpack
# Timeout nhận event (giây)
WS_EVENT_TIMEOUT_SEC=10
# Số lần retry khi kết nối thất bại
WS_RECONNECT_ATTEMPTS=3
# Thời gian chờ giữa các lần reconnect (giây)
WS_RECONNECT_DELAY_SEC=2

# ── Tham Số Test ────────────────────────────────────────────────
TEST_ORDER_SYMBOL=VNM
TEST_ORDER_PRICE=75000
TEST_ORDER_QTY=100

# Channels cần subscribe (dùng cho MarketData WS)
WS_TEST_SYMBOLS=VNM,SSI,VIC
WS_OHLC_RESOLUTION=1

# ── Giới Hạn Tier (dùng cho test connection limit) ──────────────
NORMAL_USER_MAX_CONNECTOR=10
VIP_USER_MAX_CONNECTOR=25
ULTIMATE_USER_MAX_CONNECTOR=50

NORMAL_USER_MAX_STREAM=200
VIP_USER_MAX_STREAM=400
ULTIMATE_USER_MAX_STREAM=400

NORMAL_USER_RATE_LIMIT=10
VIP_USER_RATE_LIMIT=50
ULTIMATE_USER_RATE_LIMIT=200

# ── SLA ─────────────────────────────────────────────────────────
# Độ trễ tối đa chấp nhận để nhận event (ms)
WS_EVENT_LATENCY_MAX_MS=500

# ── Database (Metabase UAT — chỉ READ) ──────────────────────────
METABASE_UAT_URL=https://metabase-uat.dnse.com.vn
METABASE_UAT_DB_TIMESCALE_ID=644
METABASE_SESSION_TOKEN=

# ── Output ──────────────────────────────────────────────────────
RESULT_DIR=workspace/{issueKey}/test/result
