# =================================================================
# ENV TEMPLATE — REST API Tasks
# Sao chép file này thành workspace/{issueKey}/test/.env
# Điền giá trị thực tế vào, KHÔNG commit file .env lên Git
# =================================================================

# ── Môi Trường ──────────────────────────────────────────────────
# UAT (mặc định) | staging | sandbox
ENVIRONMENT=uat

# ── REST API Base URL ────────────────────────────────────────────
BASE_URL=https://openapi-uat.dnse.com.vn
# Nếu test qua API Gateway nội bộ:
# BASE_URL=https://internal-gw-uat.dnse.com.vn

# ── Xác Thực (Credentials) ──────────────────────────────────────
# Tài khoản UAT chính (User A)
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Tài khoản UAT thứ hai (User B - dùng cho test Data Isolation)
NORMAL_USER_API_KEY=user_b_api_key_here
NORMAL_USER_API_SECRET=user_b_api_secret_here

# Internal Service Token (cho các API nội bộ yêu cầu x-internal-service-token)
INTERNAL_SERVICE_TOKEN=your_internal_token_here

# ── Tài Khoản Kiểm Thử ──────────────────────────────────────────
UAT_ACCOUNT_NO=your_account_no_here
# Tiểu khoản (nếu cần): 0001170086.1 / 0001170086.6
UAT_SUB_ACCOUNT_NO=your_sub_account_here

# ── Tham Số Test ────────────────────────────────────────────────
# Mã chứng khoán test (lấy từ Metabase UAT, KHÔNG tự bịa)
TEST_ORDER_SYMBOL=VNM
# Giá tham chiếu — đọc từ DB, cập nhật trước mỗi phiên test
TEST_ORDER_PRICE=75000
TEST_ORDER_QTY=100

# ── SLA & Timeout ───────────────────────────────────────────────
# Ngưỡng thời gian phản hồi tối đa (ms)
API_SLA_MS=2000
# Timeout cho mỗi request (giây)
REQUEST_TIMEOUT_SEC=30

# ── Database (Metabase UAT — chỉ READ) ──────────────────────────
METABASE_UAT_URL=https://metabase-uat.dnse.com.vn
METABASE_UAT_DB_TIMESCALE_ID=644
# Dùng Session Token (lấy qua POST /api/session) — KHÔNG hardcode password
METABASE_SESSION_TOKEN=

# ── Output ──────────────────────────────────────────────────────
# Thư mục lưu kết quả test (đừng thay đổi)
RESULT_DIR=workspace/{issueKey}/test/result
