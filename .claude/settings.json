{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash plugins/qa/skills/qa-test-design/assets/qa-init.sh:*)",
      "Bash(bash ${AGENT_SKILLS_HOME:-.}/plugins/qa/skills/qa-test-design/assets/qa-init.sh:*)",
      "Bash(bash plugins/qa/skills/qa-test-design/assets/qa-validate.sh:*)",
      "Bash(bash ${AGENT_SKILLS_HOME:-.}/plugins/qa/skills/qa-test-design/assets/qa-validate.sh:*)",
      "Bash(bash plugins/qa/skills/qa-squash-push/assets/squash-push.sh:*)",
      "Bash(bash ${AGENT_SKILLS_HOME:-.}/plugins/qa/skills/qa-squash-push/assets/squash-push.sh:*)",
      "Bash(bash plugins/ba-po/skills/ba-spec/assets/jira-auth-check.sh:*)",
      "Bash(bash ${AGENT_SKILLS_HOME:-.}/plugins/ba-po/skills/ba-spec/assets/jira-auth-check.sh:*)",
      "Bash(bash plugins/ba-po/skills/ba-spec/assets/jira-fetch-pdf.sh:*)",
      "Bash(bash ${AGENT_SKILLS_HOME:-.}/plugins/ba-po/skills/ba-spec/assets/jira-fetch-pdf.sh:*)",
      "Bash(node plugins/ba-po/skills/ba-refine/assets/jira-push-spec.js:*)",
      "Bash(node ${AGENT_SKILLS_HOME:-.}/plugins/ba-po/skills/ba-refine/assets/jira-push-spec.js:*)",
      "Bash(python3 plugins/ba-po/skills/ba-design-flowchart/assets/export.py:*)",
      "Bash(python3 ${AGENT_SKILLS_HOME:-.}/plugins/ba-po/skills/ba-design-flowchart/assets/export.py:*)",
      "Bash(node plugins/core/skills/meta-cross-validation/assets/trace-check.js:*)",
      "Bash(node ${AGENT_SKILLS_HOME:-.}/plugins/core/skills/meta-cross-validation/assets/trace-check.js:*)",
      "Bash(bash .agents/hooks/claude/session-start.sh)",
      "Bash(pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(behave:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(node scripts/validators/validate-skills.js:*)",
      "Bash(node scripts/validators/validate-commands.js:*)",
      "Bash(node scripts/validators/validate-reference-links.js:*)",
      "Bash(node scripts/validators/validate-artifact-paths.js:*)",
      "Bash(node scripts/evals/run-evals.js:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git stash list:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(mkdir -p:*)",
      "Read(./**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(cat .env:*)",
      "Bash(cat ./.env:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PROJECT_DIR}/.agents/hooks/claude/session-start.sh\"; [ -f \"$SCRIPT\" ] && bash \"$SCRIPT\" || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.agents/hooks/claude/session-end.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.agents/hooks/core/check-branch.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(pytest:*)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.agents/hooks/claude/qa-log-guard.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(behave:*)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.agents/hooks/claude/qa-log-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.agents/hooks/claude/pre-tool-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.agents/hooks/claude/pre-tool-guard.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.agents/hooks/claude/post-tool-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.agents/hooks/claude/post-tool-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
