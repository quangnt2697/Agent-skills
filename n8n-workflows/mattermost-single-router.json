          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"system_instruction\": {\n    \"parts\": [{\n      \"text\": \"Bạn là Intent Classifier và Text-to-SQL Assistant cho ChatOps Mattermost. Cú pháp: /agent [project] [skill-name] [issueKey] hoặc /agent query [lời nói tự nhiên / câu lệnh SQL].\\nFormat JSON bắt buộc:\\n{\\n  \\\"intent\\\": \\\"standup|run-test|recon|jira|squash|sync|push-jira|query|help\\\",\\n  \\\"params\\\": {\\n    \\\"project\\\": \\\"...\\\",\\n    \\\"skill\\\": \\\"...\\\",\\n    \\\"issueKey\\\": \\\"...\\\",\\n    \\\"database\\\": \\\"openapi|timescale|sandbox\\\",\\n    \\\"query\\\": \\\"câu lệnh SQL SELECT...\\\",\\n    \\\"userQuestion\\\": \\\"câu hỏi gốc của người dùng\\\"\\n  }\\n}\\n\\nMapping Rules:\\n1. query: Khi người dùng gõ /agent query..., /agent sql..., hoặc hỏi bằng tiếng Việt tự nhiên về số dư tài khoản, lệnh đặt, Virtual Account, giá cổ phiếu, khớp lệnh thị trường.\\n   - Tra cứu tài khoản, số dư, lệnh, VA -> database: 'openapi' (Bảng: accounts(account_no, status, available_cash, hold_amount), orders(order_id, account_no, symbol, volume, price, status, side, created_at), virtual_accounts(account_number, account_name, bank_id, napas_code, investor_account_id, status)).\\n   - Tra cứu giá thị trường, bước giá, nến, ticks -> database: 'timescale' (Bảng: mdds_ticks_v3(sending_time, symbol, price, volume, match_type, ceiling_price, floor_price, reference_price)).\\n   - Tự động sinh câu SQL chuẩn PostgreSQL SELECT, luôn có LIMIT 50 nếu không chỉ định.\\n2. Các intent khác: run-test (qa-run-test, test, kiểm thử), standup (daily, sprint), recon (đối chiếu watchdog), jira (tra cứu vé BA), squash (push-squash, squash, đẩy gherkin test case lên Squash TM), sync (đồng bộ git), push-jira (đẩy spec refined.md lên Jira), help (mặc định khi không rõ).\"\n    }]\n  },\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \" Câu lệnh từ Mattermost: \" + ($json.body.text || '')\n    }]\n  }],\n  \"generationConfig\": {\n    \"temperature\": 0.1,\n    \"maxOutputTokens\": 350,\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "options": {}
      },
      "id": "2",
      "name": "Antigravity Intent Recognition",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// M1: Delegate toàn bộ logic sang file script riêng (dễ maintain, không bloat JSON)\nconst path = require('path');\nconst fs = require('fs');\n\n// Resolve đường dẫn tuyệt đối đến script file\nconst workspaceDir = ($env && $env.AGENT_WORKSPACE_DIR) || process.cwd();\nconst scriptPath = path.resolve(workspaceDir, 'scripts/n8n-nodes/router-parse-ai-output.js');\n\nif (!fs.existsSync(scriptPath)) {\n  // Fallback: chạy inline nếu file script không tồn tại\n  const input = $input.first();\n  const webhookBody = ($('Webhook (Mattermost Slash Command)').first()?.json?.body) || {};\n  return [{ json: { intent: 'help', params: {}, ackMessage: '', originalCommand: webhookBody.text || '', userName: webhookBody.user_name || 'User', _fallback: true } }];\n}\n\n// Eval script với context n8n đầy đủ (biến $, $env, $input đã tồn tại)\nconst scriptCode = fs.readFileSync(scriptPath, 'utf-8');\nreturn await (async function() { eval(scriptCode); })();"
      },
