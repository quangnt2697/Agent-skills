{
  "name": "AgentSkills - Mattermost Single Router",
  "id": "LAM5C3oT3ZikcvsM",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mattermost-router",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1",
      "name": "Webhook (Mattermost Slash Command)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "mattermost-router"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $env.GEMINI_AGENT_MODEL || 'antigravity' }}:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"system_instruction\": {\n    \"parts\": [{\n      \"text\": \"Bạn là Intent Classifier cho hệ thống ChatOps. Phân tích câu lệnh và trả về JSON thuần túy (không dùng markdown code block). Format bắt buộc: {\\\"intent\\\": \\\"standup|test|jira|squash|sync|help\\\", \\\"params\\\": {\\\"issueKey\\\": \\\"...\\\"}}.  Quy tắc: standup=báo cáo/daily/sprint, test=chạy test/kiểm thử, jira=lấy issue/vé (params.issueKey bắt buộc), squash=đẩy test case, sync=đồng bộ code/repo/pull, help=mặc định khi không rõ.\"\n    }]\n  },\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \" Câu lệnh từ Mattermost: \" + $json.body.text\n    }]\n  }],\n  \"generationConfig\": {\n    \"temperature\": 0.1,\n    \"maxOutputTokens\": 256,\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "options": {}
      },
      "id": "2",
      "name": "Antigravity Intent Recognition",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "try {\n  const response = $input.first().json;\n  const rawText = response.candidates?.[0]?.content?.parts?.[0]?.text || '';\n  // Handle: JSON thuần, markdown code block, hoặc Antigravity trả nested object\n  let data;\n  if (typeof rawText === 'object') {\n    data = rawText;\n  } else {\n    const cleanJson = rawText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n    data = JSON.parse(cleanJson);\n  }\n  // Validate intent hợp lệ\n  const validIntents = ['standup', 'test', 'jira', 'squash', 'sync', 'help'];\n  if (!validIntents.includes(data.intent)) data.intent = 'help';\n  return [{ json: data }];\n} catch(e) {\n  return [{ json: { intent: 'help', error: e.message } }];\n}"
      },
      "id": "3",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.intent }}",
        "rules": {
          "rules": [
            {
              "value2": "standup",
              "output": 0
            },
            {
              "value2": "test",
              "output": 1
            },
            {
              "value2": "jira",
              "output": 2
            },
            {
              "value2": "squash",
              "output": 3
            }
          ]
        },
        "fallbackOutput": 4
      },
      "id": "4",
      "name": "Switch by Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        880,
        300
      ]
    },
    {
