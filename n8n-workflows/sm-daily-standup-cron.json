{
  "name": "AgentSkills - Scrum Master Autonomous Standup",
  "id": "1F7hWRkWoSAIYuH9",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 8 * * 1-5"
            }
          ]
        }
      },
      "id": "1",
      "name": "Cron 08:30 AM (Mon-Fri)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {},
      "id": "2",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        220,
        400
      ]
    },
    {
      "parameters": {
        "url": "={{ ($json.body && $json.body.baseUrl) || $env.ATLASSIAN_BASE_URL || 'https://entrade.atlassian.net' }}/rest/api/3/search?jql=sprint%20in%20openSprints()%20AND%20statusCategory%20!=%20Done&fields=summary,status,assignee,priority,updated",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {}
      },
      "id": "3",
      "name": "Query Active Sprint Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const issues = $input.first().json.issues || [];\nconst now = new Date();\nconst stuckIssues = [];\nconst assigneeWorkload = {};\n\nfor (const issue of issues) {\n  const f = issue.fields;\n  const assignee = f.assignee ? f.assignee.displayName : 'Chưa phân bổ';\n  assigneeWorkload[assignee] = (assigneeWorkload[assignee] || 0) + 1;\n\n  // Kiểm tra ticket bị kẹt > 3 ngày chưa cập nhật\n  const updated = new Date(f.updated);\n  const diffDays = (now - updated) / (1000 * 60 * 60 * 24);\n  if (diffDays >= 3) {\n    stuckIssues.push({\n      key: issue.key,\n      summary: f.summary,\n      assignee: assignee,\n      status: f.status ? f.status.name : '',\n      stuckDays: Math.round(diffDays)\n    });\n  }\n}\n\nlet reportText = `### 📋 BÁO CÁO DAILY STANDUP (${now.toISOString().split('T')[0]})\\n`;\nreportText += `- **Tổng số task đang mở:** ${issues.length}\\n`;\nreportText += `- **Cảnh báo Task bị treo (>3 ngày):** ${stuckIssues.length}\\n\\n`;\n\nif (stuckIssues.length > 0) {\n  reportText += `#### 🚨 Danh sách Task bị tắc nghẽn (Impediments):\\n`;\n  for (const s of stuckIssues) {\n    reportText += `- **[${s.key}]** ${s.summary} (👤 ${s.assignee} | ⏳ ${s.stuckDays} ngày chưa cập nhật)\\n`;\n  }\n}\n\nreturn [{ json: { reportText, totalIssues: issues.length, stuckCount: stuckIssues.length } }];"
      },
      "id": "4",
      "name": "Analyze Velocity & Blockers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MATTERMOST_WEBHOOK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"{{ $json.reportText }}\"\n}",
        "options": {}
      },
      "id": "5",
      "name": "Respond to Caller",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        300
      ]
    }
  ],
  "connections": {
    "Cron 08:30 AM (Mon-Fri)": {
      "main": [
        [
          {
            "node": "Query Active Sprint Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Query Active Sprint Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Active Sprint Issues": {
      "main": [
        [
          {
            "node": "Analyze Velocity & Blockers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze Velocity & Blockers": {
      "main": [
        [
          {
            "node": "Respond to Caller",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
